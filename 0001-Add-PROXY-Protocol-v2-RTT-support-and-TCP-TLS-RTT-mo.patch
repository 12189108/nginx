+            tlv_data = p;
+
+            if (tlv->type == NGX_PROXY_PROTOCOL_TLV_TCP_RTT && tlv_len == 4) {
+                pp->tcp_rtt = ngx_proxy_protocol_parse_uint32(tlv_data);
