ngx_addon_name=ngx_tcp_rtt_module

# HTTP module
ngx_module_type=HTTP
ngx_module_name=ngx_http_tcp_rtt_module
ngx_module_srcs="$ngx_addon_dir/ngx_http_tcp_rtt_module.c"
if test -n "$ngx_module_link"; then
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_tcp_rtt_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_tcp_rtt_module.c"
fi

# Stream module
ngx_module_type=STREAM
ngx_module_name=ngx_stream_tcp_rtt_module
ngx_module_srcs="$ngx_addon_dir/ngx_stream_tcp_rtt_module.c"
if test -n "$ngx_module_link"; then
    . auto/module
else
    STREAM_MODULES="$STREAM_MODULES ngx_stream_tcp_rtt_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_stream_tcp_rtt_module.c"
fi