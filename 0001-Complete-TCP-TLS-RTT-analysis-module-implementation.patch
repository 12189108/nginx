+# Sample NGINX configuration for TCP/TLS RTT analysis module
+
+# Run with: nginx -c /path/to/this/nginx.conf
+
+worker_processes 1;
+error_log logs/error.log debug;
+events {
+    worker_connections 1024;
+}
+
+# Stream configuration for TCP RTT analysis
+stream {
+    # Log format to include proxy protocol info
+    log_format proxy '$remote_addr [$time_local] $protocol $status $bytes_sent $bytes_received $session_time "$upstream_addr" "$upstream_bytes_sent" "$upstream_bytes_received" "$upstream_connect_time"';
+
+    upstream tcp_backend {
+        server 127.0.0.1:8080;
+    }
+
+    server {
+        listen 9000 proxy_protocol;
+        proxy_pass tcp_backend;
+        proxy_protocol on;
+        
+        # Enable TCP RTT calculation and add to proxy protocol v2
+        tcp_rtt on;
+        
+        access_log logs/stream_access.log proxy;
+        
+        # Optional: Add proxy protocol header for upstream
+        proxy_protocol on;
+    }
+}
+
+# HTTP configuration for TLS RTT analysis and reading TCP RTT
+http {
+    include       mime.types;
+    default_type  application/octet-stream;
+
+    # Log format to include RTT values
+    log_format rtt '$remote_addr - $remote_user [$time_local] "$request" '
+                    '$status $body_bytes_sent "$http_referer" '
+                    '"$http_user_agent" "$http_x_forwarded_for" '
+                    'tcp_rtt=$tcp_rtt tls_rtt=$tls_rtt';
+
+    upstream http_backend {
+        server 127.0.0.1:8081;
+    }
+
+    server {
+        listen 8000 ssl;
+        server_name localhost;
+
+        # SSL configuration
+        ssl_certificate     /etc/nginx/ssl/cert.pem;
+        ssl_certificate_key /etc/nginx/ssl/key.pem;
+        ssl_protocols       TLSv1.2 TLSv1.3;
+        ssl_ciphers         HIGH:!aNULL:!MD5;
+
+        # Enable RTT analysis
+        tls_rtt on;          # Calculate TLS RTT
+        tcp_rtt_read on;     # Read TCP RTT from proxy protocol
+
+        # Add RTT values to response headers for debugging
+        add_header X-TCP-RTT $tcp_rtt always;
+        add_header X-TLS-RTT $tls_rtt always;
+
+        location / {
+            proxy_pass http://http_backend;
+            proxy_set_header Host $host;
+            proxy_set_header X-Real-IP $remote_addr;
+            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+            proxy_set_header X-Forwarded-Proto $scheme;
+        }
+
+        location /rtt-info {
+            return 200 "TCP RTT: $tcp_rtt ms\nTLS RTT: $tls_rtt ms\n";
+            add_header Content-Type text/plain;
+        }
+
+        access_log logs/http_access.log rtt;
+        error_log logs/http_error.log;
+    }
+
+    # Simple backend server for testing
+    server {
+        listen 8081;
+        server_name backend;
+
+        location / {
+            return 200 "Backend server\n";
+            add_header X-Backend http;
+        }
+    }
+}
+
+# Simple TCP backend for testing (can be a netcat server)
+# To test: nc -l 8080
